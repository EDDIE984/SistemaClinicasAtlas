{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/maternidad-cotizacion.ts": {
      "includeFiles": "api/_assets/maternidad/**"
    },
    "api/consulta-cliente.ts": {
      "maxDuration": 60
    },
    "api/validar-correo.ts": {
      "maxDuration": 90
    },
    "api/maternidad-correos.ts": {
      "maxDuration": 60
    },
    "api/maternidad-adjunto.ts": {
      "includeFiles": "api/_assets/maternidad/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/consulta-cedula",
      "destination": "/api/consulta-cedula"
    },
    {
      "source": "/api/consulta-cliente",
      "destination": "/api/consulta-cliente"
    },
    {
      "source": "/api/validar-correo",
      "destination": "/api/validar-correo"
    },
    {
      "source": "/api/diagnostico-ia",
      "destination": "/api/diagnostico-ia"
    },
    {
      "source": "/api/send-whatsapp",
      "destination": "/api/send-whatsapp"
    },
    {
      "source": "/api/imagen-base64",
      "destination": "/api/imagen-base64"
    },
    {
      "source": "/api/maternidad-cotizacion",
      "destination": "/api/maternidad-cotizacion"
    },
    {
      "source": "/api/maternidad-correos",
      "destination": "/api/maternidad-correos"
    },
    {
      "source": "/api/maternidad-adjunto",
      "destination": "/api/maternidad-adjunto"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
