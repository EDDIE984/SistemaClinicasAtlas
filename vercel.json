{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/maternidad-cotizacion.ts": {
      "includeFiles": "api/_assets/maternidad/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/consulta-cedula",
      "destination": "/api/consulta-cedula"
    },
    {
      "source": "/api/diagnostico-ia",
      "destination": "/api/diagnostico-ia"
    },
    {
      "source": "/api/send-whatsapp",
      "destination": "/api/send-whatsapp"
    },
    {
      "source": "/api/imagen-base64",
      "destination": "/api/imagen-base64"
    },
    {
      "source": "/api/maternidad-cotizacion",
      "destination": "/api/maternidad-cotizacion"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
